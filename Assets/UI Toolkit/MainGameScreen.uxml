<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainGameScreen.uss?fileID=7433441132597879392&amp;guid=b54df33fc4d1ca344b6fc19144118466&amp;type=3#MainGameScreen"/>
    <ui:VisualElement name="MainGameScreen" class="MainGameScreen" style="background-color: rgba(0, 0, 0, 0);">
        <ui:VisualElement name="MainContainter" class="MainContainer" style="visibility: visible;">
            <ui:Button name="MainGameImage" class="Image" style="visibility: hidden;"/>
            <ui:VisualElement name="Upgrades" class="Upgrades">
                <ui:Label text="Upgrades" name="UpgradeLabel" double-click-selects-word="false" class="UpgradeLabel" style="visibility: hidden;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ResourceList" class="ResourceList">
                <ui:VisualElement name="SpaceRock" class="Resource">
                    <ui:VisualElement name="SpaceRockLeft" class="ResourceImageElement">
                        <ui:Image name="SpaceRockIMG" class="ResourceImage"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SpaceRockRight" class="ResourceElement" style="flex-grow: 1;">
                        <ui:Label text="Label" name="SpaceRockLabel" class="ResourceElementLabel"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="SpaceCopper" class="Resource" style="flex-grow: 1;">
                    <ui:VisualElement name="SpaceCopperLeft" class="ResourceImageElement">
                        <ui:Image name="SpaceCopperIMG" class="ResourceImage"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SpaceCopperRight" class="ResourceElement">
                        <ui:Label text="Label" name="SpaceCopperLabel" class="ResourceElementLabel"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="SpaceIron" class="Resource" style="flex-grow: 1;">
                    <ui:VisualElement name="SpaceIronLeft" class="ResourceImageElement">
                        <ui:Image name="SpaceIronIMG" class="ResourceImage"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SpaceIronRight" class="ResourceElement" style="flex-grow: 1;">
                        <ui:Label text="Label" name="SpaceIronLabel" class="ResourceElementLabel"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="NavBar" class="NavBar" style="display: flex; visibility: hidden;"/>
    </ui:VisualElement>
</ui:UXML>
