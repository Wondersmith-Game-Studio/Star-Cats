.SaveSelector {
    margin-bottom: 5%;
    margin-top: 5%;
    height: 20%;
    position: relative;
    width: 80%;
    top: auto;
    left: auto;
    background-color: rgb(13, 11, 104);
}

.ButtonContainer {
    opacity: 1;
    background-size: 100% 100%;
    width: 33%;
    transform-origin: center;
    height: 100%;
    flex-shrink: 0;
    align-self: auto;
    align-content: auto;
    align-items: center;
    position: relative;
    right: auto;
    bottom: auto;
    left: 0%;
    top: 0%;
    translate: 0 0%;
    background-color: rgba(63, 29, 1, 0);
}

.MainMenuButton {
    width: 90%;
    height: 20%;
    background-color: rgb(144, 77, 22);
    border-left-color: rgb(63, 0, 114);
    border-right-color: rgb(63, 0, 114);
    border-top-color: rgb(63, 0, 114);
    border-bottom-color: rgb(63, 0, 114);
    font-size: 20px;
    color: rgb(0, 0, 0);
    align-items: auto;
    align-content: auto;
    flex-wrap: wrap;
    flex-grow: 1;
    margin-bottom: 10%;
    margin-top: 10%;
    padding-top: 0%;
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

.MainMenu {
    height: 100%;
    width: 100%;
    flex-basis: 100%;
    flex-shrink: 0;
    align-items: auto;
    align-content: auto;
}

.TitleText {
    position: relative;
    top: 0%;
    left: 0%;
    right: auto;
    bottom: auto;
    align-items: center;
    align-self: center;
    width: 50%;
    -unity-text-align: middle-center;
    font-size: 48px;
    -unity-font-style: italic;
    color: rgb(9, 0, 125);
    flex-wrap: wrap;
    height: 100%;
    justify-content: center;
    align-content: auto;
}

.MainMenuParent {
    width: 100%;
    height: 100%;
    flex-basis: 100%;
    flex-grow: 1;
}

.MainMenuVisual {
    flex-grow: 1;
    flex-direction: column;
    flex-wrap: nowrap;
    width: 66%;
    background-color: rgb(0, 0, 0);
    height: 100%;
    flex-shrink: 1;
    flex-basis: 100%;
}

.TitleContainer {
    flex-grow: 0;
    height: 0%;
    width: 100%;
    flex-basis: 10%;
    flex-wrap: nowrap;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    align-content: auto;
    -unity-text-align: upper-left;
}

.MainMenuImage {
    flex-grow: 1;
    height: 100%;
    left: 0;
    top: 0;
}

.SaveSelectorContainer {
    width: 50%;
    height: 50%;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-basis: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(104, 65, 32);
    margin-top: 10%;
    margin-bottom: 10%;
    border-top-width: 3px;
    border-left-width: 3px;
    border-bottom-width: 3px;
    border-right-width: 3px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}
