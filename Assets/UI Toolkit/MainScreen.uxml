<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenu.uss?fileID=7433441132597879392&amp;guid=bf121dee6a5a4494b8ba8c79c6735f8d&amp;type=3#MainMenu"/>
    <ui:VisualElement name="MainMenuParent" class="MainMenuParent" style="flex-direction: row; flex-wrap: nowrap; background-color: rgb(0, 0, 0);">
        <ui:VisualElement name="ButtonContainer" class="ButtonContainer" style="background-color: rgba(0, 0, 0, 0);">
            <ui:Button text="Load Game" name="LoadGame" data-source="project://database/Assets/Settings/InputSystem_Actions.inputactions?fileID=3001919216989983466&amp;guid=2bcd2660ca9b64942af0de543d8d7100&amp;type=3#UI/Click" class="MainMenuButton"/>
