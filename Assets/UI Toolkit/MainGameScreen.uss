:root {
}

.MainGameScreen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    flex-basis: 100%;
    flex-shrink: 1;
    flex-wrap: wrap;
    flex-direction: column;
}

.SpaceRockImage {
    flex-grow: 0;
    width: 30%;
    height: 50%;
    top: 25%;
    left: auto;
    right: auto;
    bottom: auto;
    transform-origin: center;
    scale: 1 1;
    background-image: url("project://database/Assets/MainGameScreen.uss?fileID=7433441132597879392&guid=b54df33fc4d1ca344b6fc19144118466&type=3#MainGameScreen");
    -unity-background-scale-mode: scale-to-fit;
    translate: 0% 0%;
    align-items: center;
    align-self: center;
    justify-content: center;
    flex-shrink: 0;
    align-content: center;
    position: absolute;
}

.MainContainer {
    width: 100%;
    height: 80%;
    flex-direction: row;
    flex-wrap: wrap;
}

.ResourceList {
    flex-grow: 1;
    left: 0;
    top: 0;
    height: auto;
    width: 25%;
    flex-direction: column;
    flex-wrap: nowrap;
    position: absolute;
    right: auto;
    bottom: auto;
    align-items: center;
    justify-content: center;
    align-content: flex-start;
}

.Image {
    width: 100%;
    background-color: rgb(35, 31, 31);
}

.Upgrades {
    width: 25%;
    position: absolute;
    right: 0;
    top: 0;
    left: auto;
    bottom: auto;
    height: 100%;
}

.NavBar {
    flex-grow: 1;
    height: 20%;
}

.Resource {
    flex-grow: 1;
    flex-wrap: wrap;
    border-left-color: rgb(255, 251, 251);
    border-right-color: rgb(255, 251, 251);
    border-top-color: rgb(255, 251, 251);
    border-bottom-color: rgb(255, 251, 251);
    border-top-width: 1px;
    border-right-width: 2px;
    border-bottom-width: 1px;
    border-left-width: 2px;
    justify-content: flex-start;
    left: auto;
    flex-direction: row;
    align-items: center;
    align-self: center;
    align-content: auto;
    width: 100%;
    height: 75px;
}

.ResourceImage {
    align-items: flex-start;
    align-self: center;
    width: 20%;
    height: 33%;
    border-left-color: rgb(255, 251, 251);
    border-right-color: rgb(255, 251, 251);
    border-top-color: rgb(255, 251, 251);
    border-bottom-color: rgb(255, 251, 251);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    justify-content: center;
    align-content: center;
    left: auto;
    top: auto;
    aspect-ratio: 1;
    bottom: auto;
}

.ResourceElement {
    flex-grow: 1;
    width: 75%;
    height: 100%;
    justify-content: center;
    color: rgb(255, 255, 255);
}

.ResourceImageElement {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    justify-content: center;
    align-content: center;
    align-self: center;
    align-items: center;
    top: auto;
    bottom: 0%;
}

.UpgradeLabel {
    -unity-text-align: upper-center;
    -unity-text-outline-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    font-size: 24px;
}

.ResourceElementLabel {
    align-content: auto;
    align-items: auto;
}
